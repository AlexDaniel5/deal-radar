# deal-radar config template. Copy to config.yaml (gitignored) and edit.
# Secrets must NOT go here directly — use ${ENV_VAR} references (resolved from
# the environment / .env). The Anthropic API key is read from the environment
# by the evaluator and is not referenced in this file.
version: 1

ai:
  provider: anthropic
  model: claude-haiku-4-5      # cheap/fast for high-volume classification
  min_rating: 4               # 1-5; only notify at/above this
  analyze_images: false       # true => send listing photos to Claude (higher cost)
  max_images: 3

marketplaces:
  facebook:
    enabled: true
    session_path:              # null => data dir default; persisted login state
    # Facebook ignores these and uses the location saved on your account (set in Marketplace).
    default_location: "Guelph, ON"
    default_radius_km: 250

schedule:
  poll_interval_seconds: 1800   # 30 min — conservative / polite
  jitter_seconds: 600
  per_request_min_interval_seconds: 25

# How much one scan may spend. Every AI evaluation is a paid API call, so this
# is the cost cap — and unlike the old CLI-only flags, the polling loop honours
# it too. 25 x 2 items is roughly a nickel a scan on claude-haiku-4-5; the first
# scan costs the most, because after that already-checked listings are skipped.
# Set max_evaluations_per_item to 0 for a free, scrape-only run.
scan:
  max_evaluations_per_item: 50
  max_listings_per_search: 200

# Seller messaging (EXPERIMENTAL — read the README warning; default OFF).
# When enabled, a match creates a *draft* message you review and approve in the
# web UI before it is sent; nothing ever goes out automatically.
messaging:
  enabled: true
  negotiate: true       # true => drafts open with an offer instead of asking price
  offer_percent: 90     # offer = 90% of asking, rounded to the nearest $5, never above asking

notifiers:
  - type: ntfy
    topic: deal-radar-Nov-178
    server: https://ntfy.sh
  # Telegram example (uncomment and set env vars to use):
  # - type: telegram
  #   bot_token: ${TELEGRAM_BOT_TOKEN}
  #   chat_id: ${TELEGRAM_CHAT_ID}

items:
  - name: "Gaming PC"
    enabled: true
    marketplaces: [facebook]
    search_phrases: ["gaming pc", "gaming computer", "rtx 3070", "rtx 3080", "rx 6800", "rx
          7800 xt", "radeon gaming pc"]
    include_keywords: ["rtx", "radeon", "rx", "ryzen", "intel i7", "i9"]
    exclude_keywords: ["broken", "for parts", "prebuilt office", "gtx 1050"]
    price_min: 800
    price_max: 1700
    location: "Guelph, ON"
    radius_km: 250
    description: |
      A modern gaming desktop with an Nvidia RTX 3070 / AMD Radeon RX 6700 XT or better (Nvidia or AMD only, no Intel Arc) and a Ryzen 5/7 or Intel i5/i7 (10th gen or newer). Want 16GB+ RAM; DDR5 preferred, but DDR4 is fine. An SSD is a bonus. Not interested in old office PCs, GTX 16-series cards, or parts-only units. A good deal is meaningfully below typical local resale for the GPU.

    super_alert: |
      Benchmark (alert me immediately for anything at least this good at CA$1,400 or less):
      CPU Intel Core i7-10700KF (8 cores / 16 threads, up to 5.1 GHz); GPU RTX 3080 10GB
      (e.g. Zotac Trinity OC); RAM 32GB DDR4-3600 CL16 as 2 x 16GB sticks; Z590-class
      motherboard (e.g. Gigabyte Z590 Aorus Elite); 1TB NVMe SSD (Samsung 970 EVO class);
      280mm AIO liquid cooler (Arctic Liquid Freezer II 280 class); quality 850W PSU
      (Corsair TX850M class); airflow case (Corsair 4000D Airflow class); Windows 11 Pro;
      used, like-new condition. A faster CPU or GPU, DDR5, or more RAM/storage counts as better.
      HARD REQUIREMENT: the RAM must be 2 sticks (e.g. 2 x 16GB). 4 x 8GB or any 4-stick
      kit does NOT qualify, and if the stick layout isn't stated, it does not qualify.
